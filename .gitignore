# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/

# Tauri / Rust build
app/src-tauri/target/

# Vendored Python deps — generated at build time from requirements.txt by
# scripts/vendor-deps.sh; never checked in (requirements.txt is the source of truth).
/vendor/

# Bundled CPython runtime — fetched at build time by scripts/fetch-python-runtime.sh;
# never checked in (the version + SHA256 pins in that script are the source of truth).
# (both spellings: in a dev worktree these are often SYMLINKS to the primary
# checkout, and a trailing-slash pattern does not match a symlink.)
/python-runtime/
/python-runtime

# Staged native ccusage binary — copied at build time from the installed
# @ccusage/ccusage-<platform>-<arch> npm package by scripts/stage-ccusage.sh;
# never checked in (npm install is the source of truth).
/app/src-tauri/ccusage-runtime/
/app/src-tauri/ccusage-runtime

# OS / editor
.DS_Store
.env

# Skill Hub user data (data_home content — never commit)
registry.yaml
!app/src/test/fixtures/registry.yaml
_hub-backups/
.lock
.agents/
.pi-lens/

# Local agent state
.claude/
.pi/
state/
skills/_archive/

# Private overlay — own nested git repo with a private remote; never published
private/

# In-flight OpenSpec proposals (kept private by default)
openspec/changes/

# Scratch/working docs — local-only
docs/temp/

# Stray
false

# Locally-built release artifacts (scripts/release-macos-local.sh)
dist-macos/

# Worktree-bootstrap transcripts (npm ci, vite dev server logs) — not design
# artifacts (REVIEW-W1 #12).
DESIGN-*/**/*.log
docs/changes/**/*.log

# mutmut output, in case someone runs it outside scripts/mutation/mutate.py
/mutants/
/mutation/ledger.lock
# Machine-local mutation report data (513 KB per group, regenerated by `mutate.py report <group>`); the .md next to it is committed
/mutation/reports/*.json

# Hub-written Codex execpolicy rules for this project (skill-hub.rules); runtime output like .claude/
/.codex/

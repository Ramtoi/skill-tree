  "import_comment": "Shared `@path` import-parsing corpus. Each case is a document body and the directives Claude Code would take from it. Asserted by BOTH tests/test_agent_docs_imports.py (agent_docs.parse_imports) and app/src-tauri agent_docs.rs #[test] (parse_imports), so hub sync's detection pass and the app can never disagree about what counts as an instruction file.",
  "import_cases": [
    {
      "name": "line_leading",
      "content": "@docs/rules.md\n",
      "expect": [
        "docs/rules.md"
      ]
    },
    {
      "name": "mid_line",
      "content": "- git workflow @docs/git-instructions.md\n",
      "expect": [
        "docs/git-instructions.md"
      ]
    },
    {
      "name": "two_on_one_line",
      "content": "See @README.md for overview and @package.json for commands.\n",
      "expect": [
        "README.md",
        "package.json"
      ]
    },
    {
      "name": "code_span_is_literal",
      "content": "Write `@README.md` to import it.\n",
      "expect": []
    },
    {
      "name": "code_span_then_real",
      "content": "Like `@x.md`, e.g. @docs/real.md\n",
      "expect": [
        "docs/real.md"
      ]
    },
    {
      "name": "fenced_block",
      "content": "before\n```\n@docs/example.md\n```\n@docs/real.md\n",
      "expect": [
        "docs/real.md"
      ]
    },
    {
      "name": "tilde_fenced_block",
      "content": "~~~md\n@docs/tilde.md\n~~~\n@docs/real.md\n",
      "expect": [
        "docs/real.md"
      ]
    },
    {
      "name": "indented_block",
      "content": "text\n\n    @docs/other.md\n",
      "expect": []
    },
    {
      "name": "home_relative",
      "content": "- @~/.claude/my-project-instructions.md\n",
      "expect": [
        "~/.claude/my-project-instructions.md"
      ]
    },
    {
      "name": "absolute",
      "content": "@/etc/agents/shared.md\n",
      "expect": [
        "/etc/agents/shared.md"
      ]
    },
    {
      "name": "non_markdown_target",
      "content": "Commands: @package.json\n",
      "expect": [
        "package.json"
      ]
    },
    {
      "name": "trailing_sentence_punctuation",
      "content": "Read @docs/rules.md.\n",
      "expect": [
        "docs/rules.md"
      ]
    },
    {
      "name": "email_is_not_an_import",
      "content": "Mail someone@example.com for access.\n",
      "expect": []
    },
    {
      "name": "bare_mention_is_not_an_import",
      "content": "Annotate with @Composable and @dataclass.\n",
      "expect": []
    },
    {
      "name": "derived_root_pointer",
      "content": "@AGENTS.md\n",
      "expect": [
        "AGENTS.md"
      ]
    },
    {
      "name": "pointer_plus_content",
      "content": "@AGENTS.md\n\n## Claude Code\nUse plan mode.\n",
      "expect": [
        "AGENTS.md"
      ]
    },
    {
      "name": "duplicate_is_reported_once",
      "content": "@docs/rules.md\nlater again @docs/rules.md\n",
      "expect": [
        "docs/rules.md"
      ]
    },
    {
      "name": "parent_relative",
      "content": "@../shared/rules.md\n",
      "expect": [
        "../shared/rules.md"
      ]
    },
    {
      "name": "no_imports",
      "content": "# Just a heading\n\nSome prose.\n",
      "expect": []
    }
  ]
}

{
  "schema_version": 1,
  "consumers": [
    {"side": "python", "path": "tests/test_mcp_spec.py"},
    {"side": "python", "path": "skill_hub/domain/mcp/mcp_spec.py"},
    {"side": "typescript", "path": "app/src/test/mcpContract.test.ts"},
    {"side": "typescript", "path": "app/src/lib/mcpContract.ts"}
  ],
  "patterns": {
    "key_re": "(?i)(^|[-_])(authorization|bearer)$|(api[-_]?key|token|secret|password|passwd|cookie|set-cookie|x-auth-token|x-access-token|private-token)$",
    "value_re": "(?i)^(bearer|token)\\s+\\S{8,}$",
    "prefixes": [
      "sk-",
      "sk_",
      "ghp_",
      "gho_",
      "github_pat_",
      "xoxb-",
      "xoxp-",
      "AKIA",
      "glpat-",
      "AIza"
    ],
    "opaque_re": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z0-9_\\-]{20,}$"
  },
  "cases": [
    {"key": "OPENAI_API_KEY", "value": "abcdefgh", "secret": true, "note": "key suffix rule matches regardless of the value's own shape"},
    {"key": "Content-Type", "value": "application/json", "secret": false, "note": "ordinary header, no pattern matches"},
    {"key": "X-Retry", "value": "3", "secret": false, "note": "short numeric value, ordinary key"},
    {"key": "Authorization", "value": "Bearer ${T}", "secret": false, "note": "a reference is never a literal secret"},
    {"key": "Authorization", "value": "Bearer sk-live-abcdefgh12345678", "secret": true, "note": "value_re: bearer scheme plus a long token"},
    {"key": "X-Api-Key", "value": "sk-1234567890abcdef", "secret": true, "note": "prefix sk-"},
    {"key": "note", "value": "sk_test_example", "secret": true, "note": "prefix sk_"},
    {"key": "token", "value": "ghp_1234567890abcdefghij", "secret": true, "note": "prefix ghp_ and key suffix token"},
    {"key": "aws_key", "value": "AKIA-example", "secret": true, "note": "prefix AKIA"},
    {"key": "google_key", "value": "AIza-example", "secret": true, "note": "prefix AIza"},
    {"key": "note", "value": "xoxb-example", "secret": true, "note": "prefix xoxb-"},
    {"key": "note", "value": "abc123def456ghi789jkl0", "secret": true, "note": "opaque_re: 20+ alnum chars mixing letters and digits"},
    {"key": "note", "value": "short12", "secret": false, "note": "too short for opaque_re"},
    {"key": "note", "value": "onlylettersnodigitshere", "secret": false, "note": "opaque_re requires at least one digit"},
    {"key": "password", "value": "x", "secret": true, "note": "key exact-set match wins regardless of the value"},
    {"key": "PASSWD", "value": "y", "secret": true, "note": "passwd suffix, case-insensitive"},
    {"key": "secret", "value": "z", "secret": true, "note": "secret suffix"},
    {"key": "bearer", "value": "z", "secret": true, "note": "bearer as a whole key"},
    {"key": "MY_SECRET_TOKEN", "value": "z", "secret": true, "note": "token suffix"},
    {"key": "X-Trace-Id", "value": "z", "secret": false, "note": "ordinary key, short opaque-looking value"},
    {"key": "Authorization", "value": "Bearer ", "secret": false, "note": "H02: a recognized scheme with nothing after it carries no credential"},
    {"key": "Authorization", "value": "Bearer", "secret": false, "note": "H02: scheme alone, no trailing space"},
    {"key": "Authorization", "value": "Basic", "secret": false, "note": "N7/§2.7: 'Basic' IS a recognized auth scheme with nothing after it — stays exempt, same as 'Bearer'"},
    {"key": "Authorization", "value": "token", "secret": true, "note": "N7/§2.7: 'token' is NOT a recognized auth scheme (only Bearer/Basic are) — the old regex over-exempted this bare word; the key's own authorization suffix rule must fire"},
    {"key": "Cookie", "value": "session=abcdef123456", "secret": true, "note": "H05: cookie joins the suffix set"},
    {"key": "Set-Cookie", "value": "id=abcdef123456; Path=/", "secret": true, "note": "H05: set-cookie joins the suffix set"},
    {"key": "X-Auth-Token", "value": "z", "secret": true, "note": "H05: x-auth-token joins the suffix set"},
    {"key": "X-Access-Token", "value": "z", "secret": true, "note": "H05: x-access-token joins the suffix set"},
    {"key": "Private-Token", "value": "z", "secret": true, "note": "H05: private-token joins the suffix set"},
    {"key": "TOKEN", "value": "$HOME", "secret": false, "note": "E06: an exact bare $NAME reference is not a literal secret"},
    {"key": "TOKEN", "value": "%TOKEN%", "secret": false, "note": "E06: an exact bare %NAME% reference is not a literal secret"}
  ],
  "suggest": [
    {
      "server": "context7",
      "key": "Authorization",
      "value": "Bearer sk-live-x",
      "expect_value": "Bearer ${CONTEXT7_TOKEN}",
      "expect_var": "CONTEXT7_TOKEN"
    },
    {
      "server": "context7",
      "key": "X-Api-Key",
      "value": "sk-live-y",
      "expect_value": "${CONTEXT7_X_API_KEY}",
      "expect_var": "CONTEXT7_X_API_KEY"
    }
  ]
}
